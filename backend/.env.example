# ─── Database ────────────────────────────────────────────────────────────────
# Option A: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cancer_db

# Option B: Neon.tech free cloud PostgreSQL (no local install needed)
# DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/dbname?sslmode=require

DATABASE_URL=postgresql://postgres:password@localhost:5432/cancer_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── File Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Multi-Cancer Detection API
DEBUG=true
